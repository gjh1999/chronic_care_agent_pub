APP_ENV=dev
APP_NAME=chronic-care-agent
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

DATABASE_URL=sqlite:///data/sqlite/chronic_care_v2.db
REDIS_URL=

JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ALLOW_DEV_LOGIN=true

WX_APPID=
WX_SECRET=

# Medical_Lora intent service
INTENT_BASE_URL=http://127.0.0.1:8020
INTENT_API_KEY=
INTENT_TIMEOUT=60

# External RAG service
RAG_BASE_URL=http://127.0.0.1:8010
# Docker Compose defaults to http://host.docker.internal:8010; override if needed.
RAG_DOCKER_BASE_URL=http://host.docker.internal:8010
RAG_API_KEY=
RAG_TIMEOUT=45
RAG_TOP_K=5
RAG_FAIL_OPEN=true

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-plus
LLM_TIMEOUT=60
LLM_ENABLE_THINKING=false
LLM_STREAM=false

CORS_ORIGINS=*
